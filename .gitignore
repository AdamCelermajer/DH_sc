# Machine-local inputs and tooling
/.local-inputs/
**/__pycache__/
*.pyc

# Build outputs (compiler/linker products, never source)
*.o
*.obj
*.d
*.a
*.lib
*.so
*.dll
*.exe
*.pdb
*.ilk
*.exp
*.class
*.map
**/CMakeFiles/
CMakeCache.txt
**/*_build/
**/*-build/
**/build/
**/test-output/

# Bulky evidence captures and bundles inside report folders
port/**/reports/**/*.png
port/**/reports/**/*.mp4
port/**/reports/**/*.zip
port/**/reports/**/*.ppm
*.ppm

# Android emulator logs (bulky, regenerable)
port/android-native/reports/**/*.log
port/engine-resources/reports/**/*-O1
port/engine-resources/reports/**/*-O2
port/engine-resources/reports/**/fixture-O[12]

# Original audio payloads (large, licensed; staged from .local-inputs/audio-v34/cache)
port/windows-foundation/features/audio/assets/data/sounds/*.vxn
