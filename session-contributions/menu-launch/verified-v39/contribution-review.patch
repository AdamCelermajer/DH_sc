+            if(name=="invalid-number")args={ui::SwfAsValue::number(94)};
+            else if(name=="invalid-arity")args={ui::SwfAsValue::text("MenuConfirm"),ui::SwfAsValue::number(0)};
+            else args={ui::SwfAsValue::text(name)};
