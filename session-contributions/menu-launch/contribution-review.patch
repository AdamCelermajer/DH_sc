+ if(rows_.empty()){error="Original loading hint table unavailable";return false;}
+ // NativeGetLoadingTipStrID43cb24: ARM32 multiply/add wraps before modulus.
+ random.seed=(random.seed*59051u+177149u)%14348907u;
