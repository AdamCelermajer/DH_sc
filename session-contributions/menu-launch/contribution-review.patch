+	bool edit_text_character::get_topmost_mouse_entity( character * &te, float x, float y)
+	{ 
+		if (get_visible() == false) 
+		{ 
+			return NULL; 
+		} 
+
+		const matrix&  m = get_matrix();
+
+		point   p; 
+		m.transform_by_inverse(&p, point(x, y)); 
+
+		if (m_def->m_rect.point_test(p.m_x, p.m_y)) 
+		{
+			te = this;
+			return true; 
+		} 
+
+		return false; 
+	} 
