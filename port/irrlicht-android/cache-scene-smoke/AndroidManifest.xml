<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.dh2.irrlicht.cache.scene.smoke">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="37" />
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />
    <application android:allowBackup="false" android:hasCode="false"
        android:label="DH2 Irrlicht cache scene smoke"
        android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <activity android:name="android.app.NativeActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true" android:screenOrientation="landscape">
            <meta-data android:name="android.app.lib_name" android:value="CacheScene" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
