 std::shared_ptr<void> actual_owning_thread_barrier; // stays held through Flush -> Clear
 LightRuntimeStampV56 stamp;
 // Real Main token validates the SAME runtime owner/generation and that renderer,
 // auto-registration, update and attachment readers cannot enter this interval.
 virtual bool validate_current_owning_thread()const noexcept=0;
 virtual ~MainLightQuiescenceLeaseV56()=default;
};
