# Attach new class/part once to SAME existing canonical owner. Replace its actual
# canonical_property_map_v1.cpp with this coherent successor; NEVER append a
# second map CPP alongside that existing live implementation.
function(dh2_loader_attach_floor_v72 target)
 cmake_parse_arguments(C "" "CATALOG_DIR;COMMON_CATALOG_DIR;LOADER_DIR;WORLD_DIR" "" ${ARGN})
 if(NOT TARGET ${target} OR NOT C_CATALOG_DIR OR NOT C_COMMON_CATALOG_DIR OR NOT C_LOADER_DIR OR NOT C_WORLD_DIR)
  message(FATAL_ERROR "Floor requires the existing canonical source owner and coherent source directories")
 endif()
 get_target_property(_c_sources ${target} SOURCES)
 get_target_property(_c_base ${target} SOURCE_DIR)
 set(_c_seen)
 foreach(_c_source IN LISTS _c_sources)
  if(NOT _c_source MATCHES "^\\$<")
   get_filename_component(_c_path "${_c_source}" ABSOLUTE BASE_DIR "${_c_base}")
   cmake_path(NORMAL_PATH _c_path)
   list(APPEND _c_seen "${_c_path}")
  endif()
 endforeach()
 foreach(_c_name IN ITEMS canonical_floor_v72.cpp catalog_floor_v72.cpp)
  get_filename_component(_c_path "${C_CATALOG_DIR}/${_c_name}" ABSOLUTE)
  cmake_path(NORMAL_PATH _c_path)
  if(NOT EXISTS "${_c_path}")
   message(FATAL_ERROR "Missing actual Floor production source: ${_c_path}")
  endif()
  if(NOT _c_path IN_LIST _c_seen)
   target_sources(${target} PRIVATE "${_c_path}")
   list(APPEND _c_seen "${_c_path}")
  endif()
 endforeach()
 target_include_directories(${target} PUBLIC "${C_CATALOG_DIR}" "${C_COMMON_CATALOG_DIR}" "${C_LOADER_DIR}" "${C_WORLD_DIR}")
endfunction()

