include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/native_loading_sources_v65.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/native_noncharacter_sources_v67.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/native_procedural_stream_v66.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/native_generic_catalog_sources_v70.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/native_colbox_sources_v71.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/native_floor_sources_v72.cmake")
# Complete production source attachment, not a test/configure/build runner.
# Reuses Main's actual canonical owner and ONE existing TinyXML target.
function(dh2_loader_attach_production target)
 cmake_parse_arguments(ARG "PROCEDURAL" "LOADER_DIR;WORLD_DIR;XML_TARGET;PROCEDURAL_CORE_TARGET;PROCEDURAL_EXPORT_TARGET" "" ${ARGN})
 if(NOT ARG_LOADER_DIR OR NOT ARG_WORLD_DIR OR NOT ARG_XML_TARGET)
  message(FATAL_ERROR "Production loader requires explicit coherent loader/world/XML owner directories")
 endif()
 dh2_loader_attach_native_sources_v65("${target}" LOADER_DIR "${ARG_LOADER_DIR}" WORLD_DIR "${ARG_WORLD_DIR}" XML_TARGET "${ARG_XML_TARGET}")
 dh2_loader_attach_noncharacter_catalog_v67("${target}" CATALOG_DIR "${ARG_LOADER_DIR}" LOADER_DIR "${ARG_LOADER_DIR}" WORLD_DIR "${ARG_WORLD_DIR}")
 dh2_loader_attach_generic_catalog_v70("${target}" CATALOG_DIR "${ARG_LOADER_DIR}" COMMON_CATALOG_DIR "${ARG_LOADER_DIR}" LOADER_DIR "${ARG_LOADER_DIR}" WORLD_DIR "${ARG_WORLD_DIR}")
 dh2_loader_attach_colbox_v71("${target}" CATALOG_DIR "${ARG_LOADER_DIR}" COMMON_CATALOG_DIR "${ARG_LOADER_DIR}" LOADER_DIR "${ARG_LOADER_DIR}" WORLD_DIR "${ARG_WORLD_DIR}")
 dh2_loader_attach_floor_v72("${target}" CATALOG_DIR "${ARG_LOADER_DIR}" COMMON_CATALOG_DIR "${ARG_LOADER_DIR}" LOADER_DIR "${ARG_LOADER_DIR}" WORLD_DIR "${ARG_WORLD_DIR}")
 if(ARG_PROCEDURAL)
  dh2_loader_attach_procedural_stream_v66("${target}" LOADER_DIR "${ARG_LOADER_DIR}" CORE_TARGET "${ARG_PROCEDURAL_CORE_TARGET}" EXPORT_TARGET "${ARG_PROCEDURAL_EXPORT_TARGET}")
 endif()
endfunction()
