  "selected_crypt_textual_closures": {
    "monster.luac": [
      {
        "name": "monster.luac",
        "sha256": "84f07caaeb2c04f2024cc3e27d41f33806b2c53d6e8861bb3d8b371118fd0e1d",
        "bytes": 7393,
        "includes": [],
        "source_excerpt": "local SKILLTREE_ID\t= FromFixed(GetProp(GetPyStruct(\"CharacterProperties\", \"SkillTree\")));\r\nlocal SKILL_CHANCE\t= 40;\r\nlocal traces\t\t\t= false;\r\n-- -------------------------------------------------------------------------------\r\n-- When the character is created/loaded\r\nfunction monster_OnInit()\r\n\tOnInit();\r\n\t\r\n\tm_flee_flag = true;\r\n\r\n\tBUFF_ID\t\t= GetPyOID(\"ClassTable\", \"Buff_Speed\");\r\n\tbuff = nil;\r\n\t\r\n\tsaved_X, saved_Y = GetPosition();\r\n\t\r\n----------------------------------------------------------------------------------------\r\n-- Dynamic level for monster. Monster must have there LevelMax param set to use dynamic level\r\n----------------------------------------------------------------------------------------\r\n\tlocal m_lvl_max = FromFixed(GetProp(GetPyStruct(\"CharacterProperties\", \"LevelMax\")));\r\n\tlocal m_lvl_min = FromFixed(GetProp(GetPyStruct(\"CharacterProperties\", \"LevelMin\")));\r\n\tlocal m_lvl_offset = FromFixed(GetProp(GetPyStruct(\"CharacterProperties\", \"LevelOffset\")));\r\n\tlocal pl_lvl = GetHostPlayerLevel();\r\n\tlocal pl_diff = GetHostPlayerDifficulty();\r\n\tlocal m_lvl = pl_lvl;\r\n\tlocal m_level_min, m_level_max = GetCurrentLevelRange(pl_diff);\r\n\r\n\tif(m_lvl_max > -1 ) then\r\n\t\tif(m_level_max and m_level_max > -1 ) then\r\n\t\t\tif( m_lvl <= m_level_min ) then\r\n\t\t\t\tm_lvl = m_level_min;\r\n\t\t\telse\r\n\t\t\t\tif( m_lvl >= m_level_max ) then\r\n\t\t\t\t\tm_lvl = m_level_max;\r\n\t\t\t\tend\r\n\t\t\tend\r\n\t\telse\r\n\t\t\tif( m_lvl <= m_lvl_min ) then\r\n\t\t\t\tm_lvl = m_lvl_min;\r\n\t\t\telse\r\n\t\t\t\tif( m_lvl >= m_lvl_max ) then\r\n\t\t\t\t\tm_lvl = m_lvl_max;\r\n\t\t\t\tend\r\n\t\t\tend\r\n\t\tend\r\n\t\tm_lvl = m_lvl + m_lvl_offset;\r\n\r\n\t\tSetLevel(ToFixed(m_lvl));\r\n\tend\r\n----------------------------------------------------------------------------------------\r\n-- End Dynamic level for monster\r\n-------------------------------------------------------------"
      }
    ],
    "follower.luac": [
      {
        "name": "follower.luac",
        "sha256": "2d281c3bc784bbc12356e37cff9e7bdcd44a13e1d45da1fcb21069b4fef48d9d",
        "bytes": 1901,
        "includes": [],
        "source_excerpt": "\r\n\r\n-- When the character spots an ally\r\nfunction follower_OnFriendSpotted(friend)\r\n\tif(not HasMaster()) then\r\n\t\t--Trace(\"Follower \"..GetName()..\" got a new master: \"..friend:GetName());\r\n\r\n\t\tSetMaster(friend);\r\n\t\tg_master = friend;\t-- Caching the master\r\n\tend\r\nend\r\nAddToVFTable(\"OnFriendSpotted\", \"follower_OnFriendSpotted\");\r\n\r\n\r\n-- ----------------------------------------------------------------------------------------------------\r\n-- ----------------------------------------------------------------------------------------------------\r\n-- ----------------------------------------------------------------------------------------------------\r\n\r\n\r\n-- When the character's master gets out of sight\r\nfunction follower_OnMasterOutOfSight()\r\n\tWarpBehind(g_master);\r\nend\r\nAddToVFTable(\"OnMasterOutOfSight\", \"follower_OnMasterOutOfSight\");\r\n\r\n\r\n-- ----------------------------------------------------------------------------------------------------\r\n\r\n\r\n-- When the character's master is out of attack range\r\nfunction follower_OnMasterOutOfRange()\r\n\tif(GetState() ~= GetPyCst(\"AIStates\", \"Move\")) then\r\n\t\t--Trace(\"\"..GetName()..\" has its master \"..g_master:GetName()..\" out of range\");\r\n\t\tMoveTo(g_master);\r\n\tend\r\n\tClearTarget();\r\nend\r\nAddToVFTable(\"OnMasterOutOfRange\", \"follower_OnMasterOutOfRange\");\r\n\r\n\r\n-- When the character's master is in range of a ranged attack\r\nfunction follower_OnMasterInRangedRange()\r\n\tStop();\r\nend\r\nAddToVFTable(\"OnMasterInRangedRange\", \"follower_OnMasterInRangedRange\");\r\n\r\n\r\n-- When the character's master is too close to be in ranged attack range\r\nfunction follower_OnMasterInCloseRange()\r\n\tStop();\r\nend\r\nAddToVFTable(\"OnMasterInCloseRange\", \"follower_OnMasterInCloseRange\");\r\n\r\n\r\n-- When the character's master is in range of a melee attack\r\nfunction follower_OnMaster"
      }
    ],
    "rene.luac": [
      {
        "name": "rene.luac",
        "sha256": "631e7137c6ba49fca45e6cf0b37d1e45e4f42af4ca120106274e7e28d5f56fc7",
        "bytes": 9336,
        "includes": [],
        "source_excerpt": "-- ####################################################################################################\r\n--\t Rene AI\t(Base taken from Niessa (Alain Cadieux - alain.cadieux@gameloft.com))\r\n--\r\n--\t\tSpecialized AI for Rene. He is an attacking follower, with ranged attacks;\r\n--\r\n--\t\tNOTE:\r\n--\t\t\t-\tThe various distance used for our Idle wandering can be found in MoveAround().\r\n--\t\t\t-\tHis speed boost while he catches up can be found in character_classes.pyarray.\r\n--\t\t\t-\tIDLE_DELAY represents the time before he moves to a new spot while Idle.\r\n--\t\t\t-\tWhen Idle and close enough to the player, he only uses half the IDLE_DELAY.\r\n--\t\t\t-\tCATCH_DELAY represents how often he is updating his path, in case the player\r\n--\t\t\t\tkeeps moving while he is catching up.\r\n--\r\n--\t\tBUG:\r\n--\t\t\t-\tIf the player keeps running away from him, he will keep stopping and restarting to walk,\r\n--\t\t\t\tbecause he did reach our destination from the previous \"CatchingUp()\" path finding,\r\n--\t\t\t\thowever he is still flagged as \"catching up\", because he didn't get close enough.\r\n-- ####################################################################################################\r\nlocal IDLE_DELAY\t\t= 8000;\r\nlocal CATCH_DELAY\t\t= 500;\r\nlocal WARP_DELAY\t\t= 2000;\r\n\r\nlocal CST_IDLE\t\t\t= GetPyCst(\"AIStates\", \"Idle\");\r\nlocal CST_MOVE\t\t\t= GetPyCst(\"AIStates\", \"Move\");\r\nlocal OID_HASTE\t\t\t= GetPyOID(\"ClassTable\", \"Buff_Rene_Haste\");\r\n\r\nlocal g_master \t\t\t= nil;\r\nlocal g_target \t\t\t= nil;\r\n\r\nlocal g_is_far\t\t\t= false;\r\nlocal g_is_catching_up\t= false;\r\nlocal g_catch_time\t\t= 0;\r\nlocal g_catchup_timer\t= nil;\r\n\r\nlocal traces\t\t\t= false;\r\n\r\n\r\nlocal function InitVars()\r\n\tg_master \t\t\t= nil;\r\n\tg_target \t\t\t= nil;\r\n\r\n\tg_is_far\t\t\t= false;\r\n\tg_is_catching_up\t= false;\r\n\tg_catch_time\t\t= 0;\r\n\tg_catchup_timer\t\t= nil;\r\n\r\n\ttraces\t\t\t\t= false;\r\nend\r\n\r\n"
      }
    ]
  },
